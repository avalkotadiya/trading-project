generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id @default(cuid())
  clerkId        String             @unique
  email          String             @unique
  name           String?
  imageUrl       String?
  passwordHash   String?
  role           UserRole           @default(TRADER)
  phoneNumber    String?
  telegramChatId String?
  whatsappOptIn  Boolean            @default(false)
  emailAlerts    Boolean            @default(true)
  pushAlerts     Boolean            @default(false)
  weeklyDigest   Boolean            @default(true)

  // Automation & Auto-Trade
  autoTradeEnabled  Boolean            @default(false)
  autoTradeStrategy  String?            @default("AI_SIGNAL_LAB")

  // AI Quant Bot — wallet deployment cap. The bot deploys up to this much
  // total ₹ across all open positions; once cumulative exposure reaches the
  // cap, no new entries are opened (existing ones still run their exits).
  // Per-trade size is auto-decided from Half-Kelly × composite score, no
  // longer user-controlled. `minAutoTradeAmount` is kept for legacy reads
  // but ignored by the cycle loop — the UI no longer exposes it.
  minAutoTradeAmount  Decimal          @default(1000.00) @db.Decimal(15, 2)
  maxAutoTradeAmount  Decimal          @default(50000.00) @db.Decimal(15, 2)

  // Bot risk & sizing knobs
  botTradeMode        String           @default("PAPER") // PAPER | LIVE — UI hides LIVE while BOT_FORCE_PAPER_MODE=true
  botMaxOpenPositions Int              @default(3)
  botMaxDailyLoss     Decimal          @default(2000.00) @db.Decimal(15, 2)
  botCooldownMinutes  Int              @default(15)      // re-entry cooldown per symbol
  botAllowedSymbols   String[]         @default([])      // empty = all DASHBOARD_SYMBOLS
  botLastRunAt        DateTime?

  // Quant-edge model (Half-Kelly sizing from historical backtest)
  botMinEdgePct         Float          @default(0.35)    // min expected value % per trade
  botRiskPctPerTrade    Float          @default(1.0)     // max equity % risked per trade
  botKellyCap           Float          @default(0.5)     // fractional-Kelly ceiling
  botMinCompositeScore  Int            @default(55)      // 0-100 indicator composite gate (RSI+MACD+ADX+OBV+EV)

  // Trailing stop-loss — once a position is up by `botTrailStartPct`%, the
  // stop is ratcheted up to `botTrailDistancePct`% below the latest peak so
  // running winners keep moving the floor up. Zero on either column = off.
  botTrailStartPct      Float          @default(2.0)
  botTrailDistancePct   Float          @default(1.5)

  // Sector exposure cap — no single sector may hold more than this fraction
  // of total deployed capital. Sector is read from DHAN_DASHBOARD_INSTRUMENTS.
  // 0 = uncapped; 0.4 = 40 % (default).
  botMaxSectorExposurePct Float        @default(0.40)

  // Entry-window — new entries are only opened between these HH:MM IST
  // marks; exits run all session regardless. Either column null = no window
  // (entries permitted all NSE hours). Stored as "HH:MM" so it round-trips
  // through JSON without TZ ambiguity.
  botEntryWindowStart   String?        // e.g. "09:30"
  botEntryWindowEnd     String?        // e.g. "14:00"

  botEvents           BotEvent[]
  
  // Encrypted Broker Credentials
  brokerApiKey      String?
  brokerSecret      String?
  brokerAccessToken String?

  // Virtual Wallet
  balance           Decimal            @default(100000.00) @db.Decimal(15, 2)
  
  authSessions   AuthSession[]
  watchlists     Watchlist[]
  alerts         Alert[]
  orders         Order[]
  transactions   WalletTransaction[]
  subscriptions  UserSubscription[]
  portfolio       PortfolioHolding[]
  auditLogs       AuditLog[]
  invoices        Invoice[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // DEPOSIT, WITHDRAW, TRADE_BUY, TRADE_SELL
  amount    Decimal  @db.Decimal(15, 2)
  currency  String   @default("INR")
  status    String   @default("COMPLETED")
  reference String?  // Order ID or Razorpay ID
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  symbols   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Alert {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  type        AlertType
  condition   String
  targetPrice Decimal?    @db.Decimal(12, 2)
  message     String?
  channels    String[]    @default(["in_app"])
  status      AlertStatus @default(ACTIVE)
  triggeredAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, symbol])
}

model SubscriptionPlan {
  id            String             @id @default(cuid())
  key           String             @unique
  name          String
  priceInr      Int
  interval      BillingInterval
  features      String[]
  isActive      Boolean            @default(true)
  subscriptions UserSubscription[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model UserSubscription {
  id                       String             @id @default(cuid())
  userId                   String
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     SubscriptionPlan   @relation(fields: [planId], references: [id])
  status                   SubscriptionStatus @default(TRIALING)
  razorpayCustomerId       String?
  razorpaySubscriptionId   String?
  invoices                 Invoice[]
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([userId])
  @@index([planId])
}

model Invoice {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   UserSubscription?  @relation(fields: [subscriptionId], references: [id])
  amountInr      Int
  currency       String             @default("INR")
  status         InvoiceStatus      @default(OPEN)
  provider       String             @default("mock")
  providerRef    String?
  hostedUrl      String?
  createdAt      DateTime           @default(now())
  paidAt         DateTime?

  @@index([userId])
  @@index([subscriptionId])
  @@index([status, createdAt])
}

model PortfolioHolding {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  quantity     Decimal  @db.Decimal(18, 4)
  averagePrice Decimal  @db.Decimal(12, 2)
  lastPrice    Decimal? @db.Decimal(12, 2)
  broker       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String
  direction       String      // BUY, SELL
  quantity        Int
  orderType       String      // MARKET, LIMIT, SL-M
  status          String      @default("PENDING") // PENDING, FILLED, REJECTED, CANCELLED
  brokerOrderId   String?     @unique
  entryPrice      Decimal?    @db.Decimal(12, 2)
  exitPrice       Decimal?    @db.Decimal(12, 2)
  pnl             Decimal?    @db.Decimal(12, 2)
  strategy        String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, symbol])
  @@index([status])
}

model MarketSentiment {
  id          String   @id @default(cuid())
  asset       String   // NIFTY, BANKNIFTY
  score       Float    // -1 to 1
  label       String   // BULLISH, BEARISH, NEUTRAL
  summary     String
  sources     String[]
  createdAt   DateTime @default(now())

  @@index([asset, createdAt])
}

model BotEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String   // INFO, TRADE, RISK, ERROR
  symbol    String?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model AIAlert {
  id          String   @id @default(cuid())
  type        String   // RISK, SIGNAL, INFO
  severity    String   // CRITICAL, HIGH, MEDIUM, LOW
  symbol      String?
  message     String
  action      String?  // Recommended action
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  ANALYST
  TRADER
  VIEWER
}

model TradingSignal {
  id          String          @id @default(cuid())
  symbol      String
  direction   SignalDirection
  confidence  Int
  strategy    String
  entryPrice  Decimal         @db.Decimal(12, 2)
  stopLoss    Decimal?        @db.Decimal(12, 2)
  targetPrice Decimal?        @db.Decimal(12, 2)
  timeframe   String
  summary     String
  createdAt   DateTime        @default(now())

  @@index([symbol, createdAt])
}

enum AlertType {
  PRICE
  VOLUME
  MOMENTUM
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
  FAILED
}

enum SignalDirection {
  BULLISH
  BEARISH
  NEUTRAL
}

model MarketTick {
  id           String   @id @default(cuid())
  time         DateTime @default(now())
  symbol       String
  lastPrice    Float
  volume       Int
  bidPrice     Float?
  askPrice     Float?
  openInterest Int?

  @@index([symbol, time(sort: Desc)])
}
