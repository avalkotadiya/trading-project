{
  "name": "sahara-trade-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "MVP for Sahara Trade Intelligence, an AI-powered trading analytics SaaS platform.",
  "scripts": {
    "predev": "node scripts/prisma-generate-if-stale.mjs && node scripts/dev-up.mjs",
    "dev": "next dev",
    "prerealtime:dev": "node scripts/prisma-generate-if-stale.mjs && node scripts/dev-up.mjs",
    "realtime:dev": "tsx server/realtime-server.ts",
    "prebuild": "node scripts/prisma-generate-if-stale.mjs",
    "build": "next build || (node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build)",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test:dhan": "tsx tests/dhan-integration.smoke.ts",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d postgres redis && node scripts/dev-up.mjs && prisma migrate deploy && prisma db seed",
    "docker:logs": "docker compose logs -f postgres redis",
    "docker:wait": "node scripts/dev-up.mjs",
    "db:generate": "node scripts/prisma-generate-if-stale.mjs",
    "db:generate:force": "prisma generate",
    "db:check": "node scripts/check-prisma-startup.mjs",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "postinstall": "node scripts/prisma-generate-if-stale.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.24.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/pg": "^8.20.0",
    "axios": "^1.16.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.6",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.5.5",
    "ws": "^8.18.3",
    "zod": "^3.25.67"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@hono/node-server": "^1.19.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
