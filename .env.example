# =============================================================================
# Sahara Trade Intelligence — Environment Variables Reference
# Copy this file to .env and fill in all required values.
# Never commit .env to version control — it is excluded via .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication — Clerk (https://clerk.com)
# Required for production auth. Leave blank to use the built-in session auth.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# Database — PostgreSQL (required for user accounts, portfolio, alerts)
# Local Docker: docker run --name sahara-db -e POSTGRES_PASSWORD=yourpass -p 5432:5432 -d postgres
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/sahara_trade?schema=public
PRISMA_CONNECTION_LIMIT=1
PRISMA_CLIENT_ENGINE_TYPE=library

# -----------------------------------------------------------------------------
# Cache / Rate-limiting — Redis
# Use either a local Redis URL OR Upstash REST credentials (not both).
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Broker Integration — DhanHQ (https://dhanhq.co)
# DHAN_ACCESS_TOKEN is a short-lived JWT; rotate it regularly.
# DHAN_ORDER_IP_ALLOWLIST is a comma-separated list of IPs allowed to place
# live orders (set by Dhan in your account settings).
# -----------------------------------------------------------------------------
DHAN_API_KEY=replace_me
DHAN_API_SECRET=replace_me
DHAN_CLIENT_ID=replace_me
DHAN_ACCESS_TOKEN=replace_me
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_AUTH_BASE_URL=https://auth.dhan.co
DHAN_WS_URL=wss://api-feed.dhan.co
DHAN_REDIRECT_URL=http://localhost:3000/api/dhan/auth/callback
DHAN_POSTBACK_URL=http://localhost:3000/api/dhan/webhook
DHAN_WEBHOOK_IP_ALLOWLIST=
DHAN_WEBHOOK_SECRET=replace_me
DHAN_ORDER_IP_ALLOWLIST=
# JSON array of instruments to auto-subscribe on startup, e.g.:
# [{"ExchangeSegment":"NSE_EQ","SecurityId":"1333"}]
DHAN_AUTO_SUBSCRIBE_JSON=
# Comma-separated exchange segments to auto-subscribe in full on startup.
# Supports: NSE_EQ, BSE_EQ, NSE_FNO, BSE_FNO, IDX_I, NSE_CURRENCY, BSE_CURRENCY, MCX_COMM
# Multiple WebSocket connections (5000 instruments each) are created automatically when needed.
# NEVER set this to NSE_EQ or BSE_EQ — they subscribe 6k+ symbols and crash the
# browser. The curated DHAN_DASHBOARD_INSTRUMENTS in lib/dhan-symbols.ts handles
# the ~90 well-known stocks; this env var is for indices and special cases only.
DHAN_AUTO_SUBSCRIBE_SEGMENTS=IDX_I
# Request code for auto-subscribed instruments: 15=Ticker, 17=Quote, 21=Full
DHAN_AUTO_SUBSCRIBE_REQUEST_CODE=15
DHAN_RETRY_ATTEMPTS=4
DHAN_WS_HANDSHAKE_TIMEOUT_MS=15000
DHAN_WS_STALE_TIMEOUT_MS=45000

# Dhan REST throttle (services/dhan/dhanHistoricalData.ts).
# Official Dhan Data API limits: 5/sec, 100/MIN, 1000/hr (the per-minute is
# the binding constraint, ~1.66 req/s sustained). We run 1.5 req/s with a
# 3-token burst, and enforce a sliding-window 80/min cap (20% safety margin).
# On 429: pause 30s, retry through the bucket (DhanClient internal retry
# is suppressed for these endpoints via skipRetryOn429).
DHAN_DAILY_RPS=1.5
DHAN_INTRADAY_RPS=1.5
DHAN_BUCKET_CAPACITY=3
DHAN_HIST_PER_MINUTE=80
DHAN_429_COOLDOWN_MS=30000
DHAN_HIST_MAX_RETRIES=3
DHAN_DAILY_TTL_SECONDS=21600
DHAN_INTRADAY_TTL_SECONDS=180

# Quant-edge scan
# MAX_UNIVERSE=300 with USE_INTRADAY=true → fresh scan ~5 min.
# Subsequent scans within 6 h hit the daily cache → ~30 s for intraday refresh.
QUANT_EDGE_MAX_UNIVERSE=300
QUANT_EDGE_USE_INTRADAY=true

# -----------------------------------------------------------------------------
# Market Data
# -----------------------------------------------------------------------------
MARKET_DATA_PROVIDER=dhan
MARKET_DATA_ALLOWED_SEGMENTS=NSE_EQ,NSE_FNO,BSE_EQ,BSE_FNO,IDX_I
# Optional: URL to a custom Dhan scrip master CSV (defaults to Dhan's public URL)
DHAN_SCRIP_MASTER_URL=

# -----------------------------------------------------------------------------
# Realtime WebSocket Server
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:3001/ws
REALTIME_PORT=3001

# -----------------------------------------------------------------------------
# AI — Multi-provider gateway (https://ai.google.dev)
# The gateway tries providers in AI_PROVIDER_ORDER and uses the first that
# responds, so a rate-limited or down provider never breaks AI features.
# Leave any key blank to skip that layer entirely.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_PROVIDER_ORDER=gemini,openai,anthropic
AI_REQUEST_TIMEOUT_MS=15000
AI_BREAKER_COOLDOWN_MS=60000
# AI auto-trade advisor: minimum conviction (0-100) for a quant-approved
# candidate to be traded. Only applied when an AI provider is reachable; with no
# AI key the bot trades on the quant signal alone. Lower = more trades.
BOT_AI_MIN_CONVICTION=45
# Equity quant bot automation. LIVE places real DhanHQ orders only when both
# botTradeMode=LIVE in the dashboard and DHAN_BOT_LIVE_TRADING_ENABLED=true.
BROKER_PROVIDER=DHAN
DHAN_BOT_LIVE_TRADING_ENABLED=false
DHAN_BOT_PRODUCT_TYPE=INTRADAY
BOT_COOLDOWN_MINUTES=10
BOT_INTRADAY_INTERVAL=5
QUANT_ENGINE_URL=http://localhost:8000
NEXTJS_API_URL=http://localhost:3000/api/ai
AI_DEFAULT_ACCOUNT_EQUITY=100000
AI_DEFAULT_RISK_PERCENT=1

# -----------------------------------------------------------------------------
# Security
# Use a long random string (openssl rand -hex 32).
# IP_HASH_SALT is used for GDPR-compliant IP pseudonymisation in audit logs.
# MONITORING_TOKEN gates the /api/monitoring/metrics endpoint.
# If MONITORING_TOKEN is not set, the metrics endpoint is closed entirely.
# -----------------------------------------------------------------------------
IP_HASH_SALT=replace_with_random_64_char_hex
MONITORING_TOKEN=replace_with_random_secret
# Used by Vercel Cron / external schedulers for /api/bot/cron.
CRON_SECRET=replace_with_random_secret

# -----------------------------------------------------------------------------
# Role / Admin Bootstrap
# Comma-separated email addresses that receive OWNER / ADMIN roles on first login.
# -----------------------------------------------------------------------------
OWNER_EMAILS=
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_DEFAULT_CHAT_ID=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me

# -----------------------------------------------------------------------------
# Billing — Razorpay (placeholder — not yet live)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_MODE=async
